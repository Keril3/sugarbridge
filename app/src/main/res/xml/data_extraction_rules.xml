<?xml version="1.0" encoding="utf-8"?>
<!--
   Облачный бэкап выключен (allowBackup="false"), а перенос на новый телефон Android 12+ делает всё равно.
   Аккаунт зашифрован ключом, который остаётся на старом телефоне, а список записанных минут
   относится к Health Connect старого телефона — переносить их бессмысленно.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
        <exclude domain="sharedpref" path="sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
        <exclude domain="sharedpref" path="sync.xml" />
    </device-transfer>
</data-extraction-rules>
