    <string name="settings_battery">Снять ограничения батареи</string>
    <string name="settings_live_hint">Так часто Android даёт работать только приложению с уведомлением. Если оно мешает, выключите его кнопкой выше — режим продолжит работать.</string>
    <string name="settings_display_title">Показатели</string>
    <string name="settings_target_range">Целевой диапазон:\n%1$s – %2$s %3$s</string>
